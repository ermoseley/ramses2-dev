! Composite implicit non-ideal MHD: doc/implicit_diffusion.md, sections 6-12.
module implicit_solver
  use cudafor
  use amr_parameters, only: dp, twotondim
  use hydro_parameters, only: nvar
  use oct_commons, only: oct
  use nimhd_coeff_module, only: nimhd_coeff
  use implicit_ops
  implicit none
  private
  public :: gpu_implicit_step
  integer, parameter :: nimhd_maxsplit=2
  integer :: maxiter, inner_max, inner_calls, cocg_iters, picard_iters
  integer(kind=8) :: inner_total
  integer :: pre_nonpositive
  integer :: cached_lmin=-1, cached_lf=-1, cached_ngridmax=-1
  real(kind=8) :: rtol, tol_in, eta_uniform
  real(kind=8) :: time_coeff, time_solve, time_commit
  logical :: uniform_ohmic, first_call=.true.
  real(kind=8), device, allocatable :: diag(:), cg_r(:), cg_z(:), cg_p(:), cg_ap(:), cg_true(:)
  real(kind=8), device, allocatable :: eq(:), ej(:), ee(:), ek(:)
  real(kind=8), device, allocatable :: diag_f(:), diag_g(:)
  real(kind=8), device, allocatable :: y0(:), y(:), candidate(:), de0(:), de(:), detotal(:), base_b(:,:)
contains
  ! Phase endpoints include all preceding GPU work.
  real(kind=8) function wall_time()
    integer :: info
    integer(kind=8) :: tick,rate
    info=cudaDeviceSynchronize()
    if(info/=0) error stop 'implicit: CUDA execution failed at timing boundary'
    call system_clock(tick,rate)
    wall_time=real(tick,8)/real(rate,8)
  end function wall_time

  ! Direct module allocations are required by NVHPC device descriptors.
  subroutine setup_workspace()
    if(allocated(diag)) then
       if(size(diag)==imp_nedge.and.size(y0)==imp_nface.and.size(de0)==imp_nleaf) return
       deallocate(diag,cg_r,cg_z,cg_p,cg_ap,cg_true,eq,ej,ee,ek,diag_f,diag_g)
       deallocate(y0,y,candidate,de0,de,detotal,base_b)
    endif
    allocate(diag(imp_nedge),cg_r(imp_nedge),cg_z(imp_nedge),cg_p(imp_nedge), &
         & cg_ap(imp_nedge),cg_true(imp_nedge),eq(imp_nedge),ej(imp_nedge),ee(imp_nedge),ek(imp_nedge), &
         & diag_f(imp_nface),diag_g(imp_nedge))
    allocate(y0(imp_nface),y(imp_nface),candidate(imp_nface),de0(imp_nleaf),de(imp_nleaf), &
         & detotal(imp_nleaf),base_b(3,imp_nleaf))
  end subroutine setup_workspace

  logical function finite(x)
    real(kind=8), intent(in) :: x
    finite=(x==x.and.abs(x)<=huge(x))
  end function finite

  function dot(x,y) result(s)
    real(kind=8), device, intent(in) :: x(:), y(:)
    real(kind=8) :: s
    integer :: i
    s=0d0
    !$cuf kernel do <<<*,*>>> reduce(+:s)
    do i=1,size(x)
       s=s+x(i)*y(i)
    enddo
  end function dot

  ! In-place vector updates; operator routines themselves never alias.
  subroutine axpy(y,a,x)
    real(kind=8), device, intent(inout) :: y(:)
    real(kind=8), device, intent(in) :: x(:)
    real(kind=8), intent(in) :: a
    integer :: i
    !$cuf kernel do <<<*,*>>>
    do i=1,size(y)
       y(i)=y(i)+a*x(i)
    enddo
  end subroutine axpy

  subroutine combine(z,a,x,b,y)
    real(kind=8), device, intent(out) :: z(:)
    real(kind=8), device, intent(in) :: x(:), y(:)
    real(kind=8), intent(in) :: a,b
    integer :: i
    !$cuf kernel do <<<*,*>>>
    do i=1,size(z)
       z(i)=a*x(i)+b*y(i)
    enddo
  end subroutine combine

  subroutine complex_axpy(yr,yi,ar,ai,xr,xi)
    real(kind=8), device, intent(inout) :: yr(:),yi(:)
    real(kind=8), device, intent(in) :: xr(:),xi(:)
    real(kind=8), intent(in) :: ar,ai
    integer :: i
    !$cuf kernel do <<<*,*>>>
    do i=1,size(yr)
       yr(i)=yr(i)+ar*xr(i)-ai*xi(i)
       yi(i)=yi(i)+ai*xr(i)+ar*xi(i)
    enddo
  end subroutine complex_axpy

  subroutine complex_direction(pr,pi,rr,ri,beta)
    real(kind=8), device, intent(inout) :: pr(:),pi(:)
    real(kind=8), device, intent(in) :: rr(:),ri(:)
    complex(kind=8), intent(in) :: beta
    real(kind=8) :: br,bi,oldr,oldi
    integer :: i
    br=real(beta,8); bi=aimag(beta)
    !$cuf kernel do <<<*,*>>>
    do i=1,size(pr)
       oldr=pr(i); oldi=pi(i)
       pr(i)=rr(i)+br*oldr-bi*oldi
       pi(i)=ri(i)+bi*oldr+br*oldi
    enddo
  end subroutine complex_direction

  function bilinear(xr,xi,myr,myi) result(s)
    real(kind=8), device, intent(in) :: xr(:),xi(:),myr(:),myi(:)
    complex(kind=8) :: s
    s=cmplx(dot(xr,myr)-dot(xi,myi),dot(xr,myi)+dot(xi,myr),kind=8)
  end function bilinear

  function mf_norm(x) result(s)
    real(kind=8), device, intent(in) :: x(:)
    real(kind=8), device, allocatable :: mx(:)
    real(kind=8) :: s,t
    allocate(mx(size(x)))
    call imp_mf(x,mx)
    t=dot(x,mx)
    s=huge(1d0)
    if(finite(t).and.t>=0d0) s=sqrt(t)
    deallocate(mx)
  end function mf_norm

  ! uu is the native gas state plus already accepted physical energy increments.
  attributes(global) subroutine coefficient_kernel(uold,bc,de,boxlen,gamma,smallr,etamag,eta_ad,n)
    integer, value :: n
    real(kind=dp), device, intent(in) :: uold(twotondim,nvar,*)
    real(kind=8), device, intent(in) :: bc(3,*),de(*)
    real(kind=8), value :: boxlen,gamma,smallr,etamag,eta_ad
    real(kind=dp) :: uu(nvar),bb(3),eo,ea
    real(kind=8) :: w
    integer :: c,ic,io
    c=(blockIdx%x-1)*blockDim%x+threadIdx%x
    if(c>n) return
    ic=imp_leaf_cell(c); io=imp_leaf_oct(c)
    w=boxlen*2d0**(-imp_leaf_lev(c))
    uu(:)=uold(ic,1:nvar,io)
    uu(1)=max(uu(1),real(smallr,dp))
    uu(5)=uu(5)+real(de(c)/w**3,dp)
    bb(:)=real(bc(:,c),dp)
    call nimhd_coeff(uu,bb,real(gamma,dp),real(etamag,dp),real(eta_ad,dp),eo,ea)
    imp_eta(1,c)=real(eo,8); imp_eta(2,c)=real(ea,8)
  end subroutine coefficient_kernel

  subroutine coefficients(w,uold,de,boxlen,gamma,smallr,etamag,eta_ad)
    real(kind=8), device, intent(in) :: w(:),de(:)
    real(kind=dp), device, intent(in) :: uold(twotondim,nvar,*)
    real(kind=8), intent(in) :: boxlen,gamma,smallr,etamag,eta_ad
    real(kind=8), device, allocatable :: bc(:,:)
    real(kind=8) :: omin,omax,amin,amax,t0
    integer :: i,bad
    t0=wall_time()
    allocate(bc(3,imp_nleaf))
    call imp_leaf_bc(w,bc)
    call coefficient_kernel<<<(imp_nleaf+255)/256,256>>>(uold,bc,de,boxlen,gamma,smallr,etamag,eta_ad,imp_nleaf)
    bad=0
    !$cuf kernel do <<<*,*>>> reduce(+:bad)
    do i=1,imp_nleaf
       if(imp_eta(1,i)/=imp_eta(1,i).or.abs(imp_eta(1,i))>huge(1d0).or.imp_eta(1,i)<0d0.or. &
            & imp_eta(2,i)/=imp_eta(2,i).or.abs(imp_eta(2,i))>huge(1d0).or.imp_eta(2,i)<0d0) bad=bad+1
    enddo
    if(bad/=0) error stop 'implicit: negative or non-finite nimhd_coeff'
    omin=huge(1d0); omax=0d0; amin=huge(1d0); amax=0d0
    !$cuf kernel do <<<*,*>>> reduce(min:omin,amin) reduce(max:omax,amax)
    do i=1,imp_nleaf
       omin=min(omin,imp_eta(1,i)); omax=max(omax,imp_eta(1,i))
       amin=min(amin,imp_eta(2,i)); amax=max(amax,imp_eta(2,i))
    enddo
    imp_quad=(amax>0d0)
    uniform_ohmic=(amax==0d0.and.omin==omax)
    eta_uniform=omin
    call imp_set_w(w)
    deallocate(bc)
    time_coeff=time_coeff+wall_time()-t0
  end subroutine coefficients

  ! Zero guess, Jacobi CG. Recompute residual at convergence and at exhaustion.
  subroutine inner_cg(q,x,ok,iterations)
    real(kind=8), device, intent(in) :: q(:)
    real(kind=8), device, intent(out) :: x(:)
    logical, intent(out) :: ok
    integer, optional, intent(out) :: iterations
    real(kind=8) :: qnorm,rnorm,rho,rhonew,den,alpha,beta
    integer :: i,it,nit
    logical :: restart
    x=0d0; cg_r=q; cg_p=0d0
    ok=.false.; nit=0
    qnorm=sqrt(dot(q,q))
    if(.not.finite(qnorm)) goto 100
    if(qnorm==0d0) then
       ok=.true.
       goto 100
    endif
    !$cuf kernel do <<<*,*>>>
    do i=1,imp_nedge
       cg_z(i)=cg_r(i)/diag(i)
    enddo
    cg_p=cg_z; rho=dot(cg_r,cg_z)
    do it=1,maxiter
       nit=it
       call imp_me(cg_p,cg_ap)
       den=dot(cg_p,cg_ap)
       if(.not.finite(den).or.den<=0d0.or..not.finite(rho).or.rho<=0d0) exit
       alpha=rho/den
       call axpy(x,alpha,cg_p)
       call axpy(cg_r,-alpha,cg_ap)
       rnorm=sqrt(dot(cg_r,cg_r))
       restart=.false.
       if(.not.finite(rnorm)) exit
       if(rnorm<=tol_in*qnorm) then
          call imp_me(x,cg_true)
          call combine(cg_r,1d0,q,-1d0,cg_true)
          rnorm=sqrt(dot(cg_r,cg_r))
          if(finite(rnorm).and.rnorm<=tol_in*qnorm) then
             ok=.true.
             exit
          endif
          restart=.true.
       endif
       !$cuf kernel do <<<*,*>>>
       do i=1,imp_nedge
          cg_z(i)=cg_r(i)/diag(i)
       enddo
       rhonew=dot(cg_r,cg_z)
       if(restart) then
          cg_p=cg_z
       else
          beta=rhonew/rho
          !$cuf kernel do <<<*,*>>>
          do i=1,imp_nedge
             cg_p(i)=cg_z(i)+beta*cg_p(i)
          enddo
       endif
       rho=rhonew
    enddo
    if(.not.ok) then
       call imp_me(x,cg_true)
       call combine(cg_r,1d0,q,-1d0,cg_true)
       rnorm=sqrt(dot(cg_r,cg_r))
       ok=finite(rnorm).and.rnorm<=tol_in*qnorm
    endif
100 if(present(iterations)) iterations=nit
    inner_max=max(inner_max,nit)
    inner_total=inner_total+int(nit,8); inner_calls=inner_calls+1
  end subroutine inner_cg

  subroutine mobility(j,e,ok)
    real(kind=8), device, intent(in) :: j(:)
    real(kind=8), device, intent(out) :: e(:)
    logical, intent(out) :: ok
    integer :: i
    if(uniform_ohmic) then
       !$cuf kernel do <<<*,*>>>
       do i=1,imp_nedge
          e(i)=eta_uniform*j(i)
       enddo
       ok=.true.
    else
       call imp_k(j,ek)
       call inner_cg(ek,e,ok)
    endif
  end subroutine mobility

  ! t already contains M_F times the input face vector.
  subroutine hm(t,h,ok)
    real(kind=8), device, intent(in) :: t(:)
    real(kind=8), device, intent(out) :: h(:)
    logical, intent(out) :: ok
    call imp_curlt(t,eq)
    call inner_cg(eq,ej,ok)
    if(.not.ok) return
    call mobility(ej,ee,ok)
    if(.not.ok) return
    call imp_curl(ee,h)
  end subroutine hm

  subroutine shifted(zr,zi,mzr,mzi,qr,qi,mqr,mqi,dt,ok)
    real(kind=8), device, intent(in) :: zr(:),zi(:),mzr(:),mzi(:)
    real(kind=8), device, intent(out) :: qr(:),qi(:),mqr(:),mqi(:)
    real(kind=8), intent(in) :: dt
    logical, intent(out) :: ok
    ! Reuse outputs as Hm and M_F Hm before adding the complex shift.
    call hm(mzr,qr,ok)
    if(.not.ok) return
    call hm(mzi,qi,ok)
    if(.not.ok) return
    call imp_mf(qr,mqr); call imp_mf(qi,mqi)
    call shift_kernel<<<(imp_nface+255)/256,256>>>(zr,zi,mzr,mzi,qr,qi,mqr,mqi,dt,imp_nface)
  end subroutine shifted

  attributes(global) subroutine shift_kernel(zr,zi,mzr,mzi,qr,qi,mqr,mqi,dt,n)
    integer, value :: n
    real(kind=8), value :: dt
    real(kind=8), device, intent(in) :: zr(*),zi(*),mzr(*),mzi(*)
    real(kind=8), device, intent(inout) :: qr(*),qi(*),mqr(*),mqi(*)
    integer :: i
    i=(blockIdx%x-1)*blockDim%x+threadIdx%x
    if(i>n) return
    qr(i)=zr(i)+zi(i)+dt*qr(i)
    qi(i)=zi(i)-zr(i)+dt*qi(i)
    mqr(i)=mzr(i)+mzi(i)+dt*mqr(i)
    mqi(i)=mzi(i)-mzr(i)+dt*mqi(i)
  end subroutine shift_kernel

  ! With guess, U and X of the previous Picard iterate give the initial Z=(U+iX)/2.
  subroutine cocg(y,dt,ynorm,u,x,w,guess,ok)
    real(kind=8), device, intent(in) :: y(:)
    real(kind=8), device, intent(inout) :: u(:),x(:)
    real(kind=8), device, intent(out) :: w(:)
    real(kind=8), intent(in) :: dt,ynorm
    logical, intent(in) :: guess
    logical, intent(out) :: ok
    real(kind=8), device, allocatable :: zr(:),zi(:),rr(:),ri(:),pr(:),pi(:),my(:)
    real(kind=8), device, allocatable :: mrr(:),mri(:),mpr(:),mpi(:),qr(:),qi(:),mqr(:),mqi(:)
    real(kind=8) :: norm2
    complex(kind=8) :: rho,rhonew,den,alpha,beta
    integer :: n,it,restarts
    logical :: action_ok
    tol_in=max(1d-14,1d-3*rtol)
    n=imp_nface
    allocate(zr(n),zi(n),rr(n),ri(n),pr(n),pi(n),my(n),mrr(n),mri(n),mpr(n),mpi(n), &
         & qr(n),qi(n),mqr(n),mqi(n))
    if(guess) then
       call combine(zr,0.5d0,u,0d0,u); call combine(zi,0.5d0,x,0d0,x)
    else
       call combine(zr,0.5d0,y,0d0,y); zi=zr
    endif
    call imp_mf(y,my)
    call imp_mf(zr,mpr); call imp_mf(zi,mpi)
    call shifted(zr,zi,mpr,mpi,qr,qi,mqr,mqi,dt,action_ok)
    ok=.false.; restarts=0
    if(.not.action_ok) goto 200
    call combine(rr,1d0,y,-1d0,qr); call combine(ri,-1d0,qi,0d0,qi)
    call combine(mrr,1d0,my,-1d0,mqr); call combine(mri,-1d0,mqi,0d0,mqi)
    pr=rr; pi=ri; mpr=mrr; mpi=mri
    rho=bilinear(rr,ri,mrr,mri)
    do it=0,maxiter
       norm2=dot(rr,mrr)+dot(ri,mri)
       if(.not.finite(norm2).or.norm2<0d0) exit
       if(sqrt(norm2)<=rtol*ynorm) then
          ! Recompute M_F Z and the true residual; no recurrence is trusted here.
          tol_in=max(1d-14,1d-3*rtol)
          call imp_mf(zr,mpr); call imp_mf(zi,mpi)
          call shifted(zr,zi,mpr,mpi,qr,qi,mqr,mqi,dt,action_ok)
          if(.not.action_ok) exit
          call combine(rr,1d0,y,-1d0,qr); call combine(ri,-1d0,qi,0d0,qi)
          call imp_mf(rr,mrr); call imp_mf(ri,mri)
          norm2=dot(rr,mrr)+dot(ri,mri)
          if(.not.finite(norm2).or.norm2<0d0) exit
          if(sqrt(norm2)<=10d0*rtol*ynorm) then
             ok=.true.
             exit
          endif
          if(restarts==3) exit
          restarts=restarts+1
          pr=rr; pi=ri; mpr=mrr; mpi=mri
          rho=bilinear(rr,ri,mrr,mri)
       endif
       if(it==maxiter) exit
       tol_in=max(1d-14,min(1d-4,0.1d0*rtol*ynorm/max(sqrt(norm2),tiny(1d0))))
       call shifted(pr,pi,mpr,mpi,qr,qi,mqr,mqi,dt,action_ok)
       if(.not.action_ok) exit
       den=bilinear(pr,pi,mqr,mqi)
       if(.not.finite(real(den,8)).or..not.finite(aimag(den)).or.abs(den)==0d0.or. &
            & .not.finite(real(rho,8)).or..not.finite(aimag(rho)).or.abs(rho)==0d0) exit
       alpha=rho/den
       call complex_axpy(zr,zi,real(alpha,8),aimag(alpha),pr,pi)
       call complex_axpy(rr,ri,-real(alpha,8),-aimag(alpha),qr,qi)
       call complex_axpy(mrr,mri,-real(alpha,8),-aimag(alpha),mqr,mqi)
       cocg_iters=cocg_iters+1
       rhonew=bilinear(rr,ri,mrr,mri)
       beta=rhonew/rho
       call complex_direction(pr,pi,rr,ri,beta)
       call complex_direction(mpr,mpi,mrr,mri,beta)
       rho=rhonew
    enddo
200 tol_in=max(1d-14,1d-3*rtol)
    if(ok) then
       call combine(u,2d0,zr,0d0,zr); call combine(x,2d0,zi,0d0,zi)
       call combine(w,1d0,zr,1d0,zi)
    endif
    deallocate(zr,zi,rr,ri,pr,pi,my,mrr,mri,mpr,mpi,qr,qi,mqr,mqi)
  end subroutine cocg

  ! Exact uniform-Ohmic edge action: (sigma M_E + dt*eta C^T M_F C) z.
  subroutine edge_shifted(zr,zi,qr,qi,f,mf,dt)
    real(kind=8), device, intent(in) :: zr(:),zi(:)
    real(kind=8), device, intent(out) :: qr(:),qi(:),f(:),mf(:)
    real(kind=8), intent(in) :: dt
    call imp_me(zr,ee); call imp_me(zi,eq)
    call imp_curl(zr,f); call imp_mf(f,mf); call imp_curlt(mf,ej)
    call combine(qr,1d0,ee,1d0,eq); call axpy(qr,dt*eta_uniform,ej)
    call imp_curl(zi,f); call imp_mf(f,mf); call imp_curlt(mf,ej)
    call combine(qi,1d0,eq,-1d0,ee); call axpy(qi,dt*eta_uniform,ej)
  end subroutine edge_shifted

  subroutine edge_jacobi(rr,ri,tr,ti,dt)
    real(kind=8), device, intent(in) :: rr(:),ri(:)
    real(kind=8), device, intent(out) :: tr(:),ti(:)
    real(kind=8), intent(in) :: dt
    real(kind=8) :: a,b,den,deta
    integer :: i
    deta=dt*eta_uniform
    !$cuf kernel do <<<*,*>>>
    do i=1,imp_nedge
       a=diag(i)+deta*diag_g(i); b=diag(i); den=a*a+b*b
       tr(i)=(a*rr(i)-b*ri(i))/den
       ti(i)=(a*ri(i)+b*rr(i))/den
    enddo
  end subroutine edge_jacobi

  ! The edge tolerance is tightened until the magnetic residual
  ! Y-sigma Z-dt H Z = -(dt*eta/sigma) C M_E^-1 r_e meets rtol in the M_F norm.
  subroutine cocg_ohmic(y,dt,ynorm,u,x,w,ok)
    real(kind=8), device, intent(in) :: y(:)
    real(kind=8), device, intent(out) :: u(:),x(:),w(:)
    real(kind=8), intent(in) :: dt,ynorm
    logical, intent(out) :: ok
    real(kind=8), device, allocatable :: zr(:),zi(:),rr(:),ri(:),pr(:),pi(:),rhs(:)
    real(kind=8), device, allocatable :: tr(:),ti(:),qr(:),qi(:),f(:),mf(:)
    real(kind=8) :: qnorm,norm2,target,mnorm
    logical :: inner_ok
    complex(kind=8) :: rho,rhonew,den,alpha,beta
    integer :: n,it,restarts
    tol_in=max(1d-14,1d-3*rtol)
    n=imp_nedge
    allocate(zr(n),zi(n),rr(n),ri(n),pr(n),pi(n),rhs(n),tr(n),ti(n),qr(n),qi(n), &
         & f(imp_nface),mf(imp_nface))
    call imp_mf(y,mf); call imp_curlt(mf,rhs)
    qnorm=sqrt(dot(rhs,rhs)); ok=.false.; restarts=0
    if(.not.finite(qnorm)) goto 250
    zr=0d0; zi=0d0; rr=rhs; ri=0d0
    if(qnorm==0d0) then
       ok=.true.
       goto 250
    endif
    call edge_jacobi(rr,ri,tr,ti,dt)
    pr=tr; pi=ti; rho=bilinear(rr,ri,tr,ti)
    target=rtol*qnorm
    do it=0,maxiter
       norm2=dot(rr,rr)+dot(ri,ri)
       if(.not.finite(norm2).or.norm2<0d0) exit
       if(sqrt(norm2)<=target) then
          call edge_shifted(zr,zi,qr,qi,f,mf,dt)
          call combine(rr,1d0,rhs,-1d0,qr); call combine(ri,-1d0,qi,0d0,qi)
          norm2=dot(rr,rr)+dot(ri,ri)
          if(.not.finite(norm2).or.norm2<0d0) exit
          if(sqrt(norm2)<=target) then
             ! Magnetic residual, with s = M_E^-1 r_e and s/sigma = ((sr-si)+i(sr+si))/2
             call inner_cg(rr,tr,inner_ok)
             if(inner_ok) call inner_cg(ri,ti,inner_ok)
             if(.not.inner_ok) exit
             call combine(qr,0.5d0*dt*eta_uniform,tr,-0.5d0*dt*eta_uniform,ti)
             call imp_curl(qr,f); call imp_mf(f,mf); mnorm=dot(f,mf)
             call combine(qr,0.5d0*dt*eta_uniform,tr,0.5d0*dt*eta_uniform,ti)
             call imp_curl(qr,f); call imp_mf(f,mf); mnorm=sqrt(max(0d0,mnorm+dot(f,mf)))
             if(.not.finite(mnorm)) exit
             if(mnorm<=rtol*ynorm) then
                ok=.true.
                exit
             endif
             target=target*max(1d-3,0.5d0*rtol*ynorm/mnorm)
             if(target<1d-15*qnorm) exit
          else
             if(restarts==3) exit
             restarts=restarts+1
          endif
          call edge_jacobi(rr,ri,tr,ti,dt)
          pr=tr; pi=ti; rho=bilinear(rr,ri,tr,ti)
       endif
       if(it==maxiter) exit
       call edge_shifted(pr,pi,qr,qi,f,mf,dt)
       den=bilinear(pr,pi,qr,qi)
       if(.not.finite(real(den,8)).or..not.finite(aimag(den)).or.abs(den)==0d0.or. &
            & .not.finite(real(rho,8)).or..not.finite(aimag(rho)).or.abs(rho)==0d0) exit
       alpha=rho/den
       call complex_axpy(zr,zi,real(alpha,8),aimag(alpha),pr,pi)
       call complex_axpy(rr,ri,-real(alpha,8),-aimag(alpha),qr,qi)
       cocg_iters=cocg_iters+1
       call edge_jacobi(rr,ri,tr,ti,dt)
       rhonew=bilinear(rr,ri,tr,ti); beta=rhonew/rho
       call complex_direction(pr,pi,tr,ti,beta)
       rho=rhonew
    enddo
250 if(ok) then
       ! Numerator A+iB = Y-dt*eta*C J; division by 1-i gives
       ! U=A-B, X=A+B, W=A.
       call imp_curl(zr,f); call combine(u,1d0,y,-dt*eta_uniform,f)
       call imp_curl(zi,f); call combine(x,-dt*eta_uniform,f,0d0,f)
       w=u; call combine(u,1d0,w,-1d0,x); call axpy(x,1d0,w)
    endif
    deallocate(zr,zi,rr,ri,pr,pi,rhs,tr,ti,qr,qi,f,mf)
  end subroutine cocg_ohmic

  subroutine picard(y,dt,uold,de,boxlen,gamma,smallr,etamag,eta_ad,u,x,ynorm,ok)
    real(kind=8), device, intent(in) :: y(:),de(:)
    real(kind=dp), device, intent(in) :: uold(twotondim,nvar,*)
    real(kind=8), device, intent(out) :: u(:),x(:)
    real(kind=8), intent(in) :: dt,boxlen,gamma,smallr,etamag,eta_ad
    real(kind=8), intent(out) :: ynorm
    logical, intent(out) :: ok
    real(kind=8), device, allocatable :: w(:),wn(:),delta(:),saved_eta(:,:)
    real(kind=8) :: change,scale,saved_uniform_eta,t0
    integer :: it,i,j,bad
    logical :: was_quad,was_uniform
    allocate(w(imp_nface),wn(imp_nface),delta(imp_nface),saved_eta(2,imp_nleaf))
    w=y; ynorm=mf_norm(y); ok=.false.
    if(.not.finite(ynorm).or.ynorm==huge(1d0)) goto 300
    do it=1,maxiter
       call coefficients(w,uold,de,boxlen,gamma,smallr,etamag,eta_ad)
       saved_eta=imp_eta(:,1:imp_nleaf); was_quad=imp_quad
       was_uniform=uniform_ohmic; saved_uniform_eta=eta_uniform
       picard_iters=picard_iters+1
       t0=wall_time()
       if(uniform_ohmic) then
          call cocg_ohmic(y,dt,ynorm,u,x,wn,ok)
       else
          call cocg(y,dt,ynorm,u,x,wn,it>1,ok)
       endif
       time_solve=time_solve+wall_time()-t0
       if(.not.ok) exit
       ok=.false.
       call combine(delta,1d0,wn,-1d0,w)
       change=mf_norm(delta)
       if(change<=rtol*ynorm) then
          ok=.true.
          exit
       endif
       if(.not.was_quad) then
          call coefficients(wn,uold,de,boxlen,gamma,smallr,etamag,eta_ad)
          bad=0
          !$cuf kernel do <<<*,*>>> reduce(+:bad)
          do i=1,imp_nleaf
             do j=1,2
                scale=max(abs(saved_eta(j,i)),abs(imp_eta(j,i)))
                if(abs(imp_eta(j,i)-saved_eta(j,i))>1d-14*scale) bad=bad+1
             enddo
          enddo
          if(bad==0) then
             ! Keep the exact coefficients and W used by this solve.
             imp_eta(:,1:imp_nleaf)=saved_eta; imp_quad=was_quad
             uniform_ohmic=was_uniform; eta_uniform=saved_uniform_eta
             t0=wall_time()
             call imp_set_w(w)
             time_coeff=time_coeff+wall_time()-t0
             ok=.true.
             exit
          endif
       endif
       w=wn
    enddo
300 deallocate(w,wn,delta,saved_eta)
  end subroutine picard

  subroutine stage_fields(s,j,e,ce,ok)
    real(kind=8), device, intent(in) :: s(:)
    real(kind=8), device, intent(out) :: j(:),e(:),ce(:)
    real(kind=8), device, allocatable :: ms(:)
    logical, intent(out) :: ok
    allocate(ms(imp_nface))
    call imp_mf(s,ms); call imp_curlt(ms,eq)
    call inner_cg(eq,j,ok)
    if(ok) call mobility(j,e,ok)
    if(ok) call imp_curl(e,ce)
    deallocate(ms)
  end subroutine stage_fields

  ! Stage fields are computed from U,X. The conservative energy form and r_J
  ! use B_U,X_acc, so the global cancellation also holds for inexact solves.
  subroutine stage_energy(b,j,e,ce,energy)
    real(kind=8), device, intent(in) :: b(:),j(:),e(:),ce(:)
    real(kind=8), device, intent(out) :: energy(:)
    real(kind=8), device, allocatable :: mb(:),rj(:),re(:),v(:),pi(:),q(:),rho(:)
    integer :: i
    allocate(mb(imp_nface),rj(imp_nedge),re(imp_nedge),v(imp_nedge), &
         & pi(imp_nleaf),q(imp_nleaf),rho(imp_nleaf))
    call imp_mf(b,mb); call imp_curlt(mb,eq)
    call imp_me(j,rj); call axpy(rj,-1d0,eq)
    call imp_me(e,re); call imp_k(j,ek); call axpy(re,-1d0,ek)
    !$cuf kernel do <<<*,*>>>
    do i=1,imp_nedge
       v(i)=j(i)*re(i)-e(i)*rj(i)
    enddo
    call imp_leaf_mf_form(ce,b,pi)
    call imp_leaf_k_form(j,j,q)
    call imp_edge_owner_sum(v,rho)
    !$cuf kernel do <<<*,*>>>
    do i=1,imp_nleaf
       energy(i)=pi(i)-q(i)-rho(i)
    enddo
    deallocate(mb,rj,re,v,pi,q,rho)
  end subroutine stage_energy

  attributes(global) subroutine pressure_kernel(uold,bs,de,boxlen,gamma,p,ratio,base_b,n)
    integer, value :: n
    real(kind=dp), device, intent(in) :: uold(twotondim,nvar,*)
    real(kind=8), device, intent(in) :: bs(6,*),de(*),base_b(3,*)
    real(kind=8), device, intent(out) :: p(*),ratio(*)
    real(kind=8), value :: boxlen,gamma
    real(kind=8) :: w,density,kin,mag,p0,internal
    integer :: c,ic,io
    c=(blockIdx%x-1)*blockDim%x+threadIdx%x
    if(c>n) return
    ic=imp_leaf_cell(c); io=imp_leaf_oct(c)
    w=boxlen*2d0**(-imp_leaf_lev(c))
    density=real(uold(ic,1,io),8)
    ! No density, energy or pressure floors in the acceptance check.
    if(density<=0d0.or.density/=density) then
       p(c)=-huge(1d0); ratio(c)=-huge(1d0)
       return
    endif
    kin=0.5d0*sum(real(uold(ic,2:4,io),8)**2)/density
    mag=0.125d0*((bs(1,c)+bs(4,c))**2+(bs(2,c)+bs(5,c))**2+(bs(3,c)+bs(6,c))**2)
    internal=real(uold(ic,5,io),8)+de(c)/w**3-kin-mag
    p(c)=(gamma-1d0)*internal
    ! ratio holds the raw pressure of the interval's initial state
    ratio(c)=(gamma-1d0)*(real(uold(ic,5,io),8)-kin-0.5d0*sum(base_b(:,c)**2))
  end subroutine pressure_kernel

  subroutine attempt(y,dt,uold,de0,base_b,boxlen,gamma,smallr,etamag,eta_ad,heat,xacc,de, &
       & endpoint,esum,minratio,ok)
    real(kind=8), device, intent(in) :: y(:),de0(:),base_b(:,:)
    real(kind=dp), device, intent(in) :: uold(twotondim,nvar,*)
    real(kind=8), device, intent(out) :: xacc(:),de(:)
    real(kind=8), intent(in) :: dt,boxlen,gamma,smallr,etamag,eta_ad
    logical, intent(in) :: heat
    real(kind=8), intent(out) :: endpoint,esum,minratio
    logical, intent(out) :: ok
    real(kind=8), device, allocatable :: u(:),x(:),bu(:),cu(:),cx(:),ju(:),jx(:),eu(:),ex(:)
    real(kind=8), device, allocatable :: du(:),dx(:),delta(:),bs(:,:),p(:),ratio(:),detotal(:)
    real(kind=8) :: ynorm,t0
    integer :: i,bad,npre
    allocate(u(imp_nface),x(imp_nface),bu(imp_nface),cu(imp_nface),cx(imp_nface), &
         & ju(imp_nedge),jx(imp_nedge),eu(imp_nedge),ex(imp_nedge),du(imp_nleaf),dx(imp_nleaf), &
         & delta(imp_nface),bs(6,imp_nleaf),p(imp_nleaf),ratio(imp_nleaf),detotal(imp_nleaf))
    endpoint=huge(1d0); esum=0d0; minratio=huge(1d0); de=0d0
    call picard(y,dt,uold,de0,boxlen,gamma,smallr,etamag,eta_ad,u,x,ynorm,ok)
    t0=wall_time()
    tol_in=max(1d-14,1d-3*rtol)
    if(.not.ok) goto 400
    call stage_fields(u,ju,eu,cu,ok)
    if(.not.ok) goto 400
    call stage_fields(x,jx,ex,cx,ok)
    if(.not.ok) goto 400
    call combine(delta,1d0,cu,-1d0,cx)
    call combine(bu,1d0,y,-0.5d0*dt,delta)
    call combine(delta,1d0,cu,1d0,cx)
    call combine(xacc,1d0,y,-0.5d0*dt,delta)
    call combine(delta,1d0,xacc,-1d0,x)
    endpoint=mf_norm(delta)/max(ynorm,tiny(1d0))
    ok=finite(endpoint).and.endpoint<=100d0*rtol
    if(.not.ok) goto 400
    call stage_energy(bu,ju,eu,cu,du)
    call stage_energy(xacc,jx,ex,cx,dx)
    call combine(de,-0.5d0*dt,du,-0.5d0*dt,dx)
    esum=0d0; bad=0
    !$cuf kernel do <<<*,*>>> reduce(+:esum,bad)
    do i=1,imp_nleaf
       esum=esum+de(i)
       if(de(i)/=de(i).or.abs(de(i))>huge(1d0)) bad=bad+1
    enddo
    ! The global algebraic cancellation is reported as a diagnostic.
    ok=(bad==0.and.finite(esum))
    if(.not.ok) goto 400
    if(.not.heat) then
       de=0d0
       goto 400
    endif
    call combine(detotal,1d0,de0,1d0,de)
    call imp_leaf_slots(xacc,bs)
    call pressure_kernel<<<(imp_nleaf+255)/256,256>>>(uold,bs,detotal,boxlen,gamma,p,ratio,base_b,imp_nleaf)
    ! Diffusion must not make a positive raw pressure non-positive, nor lower one that
    ! the incoming state already has non-positive (reported as npre).
    bad=0; npre=0; minratio=huge(1d0)
    !$cuf kernel do <<<*,*>>> reduce(+:bad,npre) reduce(min:minratio)
    do i=1,imp_nleaf
       if(p(i)/=p(i).or.abs(p(i))>huge(1d0).or.ratio(i)/=ratio(i).or.abs(ratio(i))>huge(1d0)) then
          bad=bad+1
       else if(ratio(i)>0d0) then
          if(p(i)<=0d0) bad=bad+1
          minratio=min(minratio,p(i)/ratio(i))
       else
          npre=npre+1
          if(p(i)<ratio(i)) bad=bad+1
       endif
    enddo
    pre_nonpositive=max(pre_nonpositive,npre)
    ok=(bad==0)
400 time_commit=time_commit+wall_time()-t0
    deallocate(u,x,bu,cu,cx,ju,jx,eu,ex,du,dx,delta,bs,p,ratio,detotal)
  end subroutine attempt

  attributes(global) subroutine commit_energy(uold,de,boxlen,n)
    integer, value :: n
    real(kind=dp), device, intent(inout) :: uold(twotondim,nvar,*)
    real(kind=8), device, intent(in) :: de(*)
    real(kind=8), value :: boxlen
    real(kind=8) :: w
    integer :: c,ic,io
    c=(blockIdx%x-1)*blockDim%x+threadIdx%x
    if(c>n) return
    ic=imp_leaf_cell(c); io=imp_leaf_oct(c)
    w=boxlen*2d0**(-imp_leaf_lev(c))
    uold(ic,5,io)=uold(ic,5,io)+real(de(c)/w**3,dp)
  end subroutine commit_energy

  subroutine gpu_implicit_step(grid,hash_key,hash_val,hash_size,ckey_max,key_off,box_ckey_min,box_ckey_max, &
       & bold,uold,head,noct,ngridmax,lmin,lf,boxlen,dt,gamma,smallr,etamag,eta_ad,heat, &
       & nimhd_rtol,nimhd_maxiter,nimhd_check,verbose,myid)
    type(oct), device :: grid(*)
    integer(kind=8), device :: hash_key(*),key_off(:)
    integer(kind=4), device :: hash_val(*),ckey_max(:),box_ckey_min(:,:),box_ckey_max(:,:)
    real(kind=dp), device :: bold(twotondim,6,*),uold(twotondim,nvar,*)
    integer, intent(in) :: hash_size,head(:),noct(:),ngridmax,lmin,lf,nimhd_maxiter,myid
    real(kind=8), intent(in) :: boxlen,dt,gamma,smallr,etamag,eta_ad,nimhd_rtol
    logical, intent(in) :: heat,nimhd_check,verbose
    real(kind=8) :: endpoint,esum,minratio,maxendpoint,total_esum,minpressure,elapsed,avg_inner
    real(kind=8) :: tstart,t0,time_build,time_check
    integer :: info,split,sub,nsub,bad,i
    logical :: ok,rejected
    tstart=wall_time()
    time_build=0d0; time_check=0d0; time_coeff=0d0; time_solve=0d0; time_commit=0d0
    imp_me_calls=0; imp_k_calls=0
    rtol=nimhd_rtol; maxiter=nimhd_maxiter; tol_in=max(1d-14,1d-3*rtol)
    inner_max=0; inner_calls=0; inner_total=0; cocg_iters=0; picard_iters=0; pre_nonpositive=0
    if(.not.imp_valid.or.lmin/=cached_lmin.or.lf/=cached_lf.or.ngridmax/=cached_ngridmax) then
       t0=wall_time()
       call imp_build(grid,hash_key,hash_val,hash_size,ckey_max,key_off,box_ckey_min,box_ckey_max, &
            & head,noct,ngridmax,lmin,lf,boxlen,info)
       if(info/=0) error stop 'implicit: topology build failed (condition P)'
       if(imp_nleaf>0) then
          call setup_workspace()
          call imp_me_diag(diag); call imp_mf_diag(diag_f); call imp_g_diag(diag_f,diag_g)
          bad=0
          !$cuf kernel do <<<*,*>>> reduce(+:bad)
          do i=1,imp_nedge
             if(diag(i)<=0d0.or.diag(i)/=diag(i).or.abs(diag(i))>huge(1d0).or. &
                  & diag_g(i)<0d0.or.diag_g(i)/=diag_g(i).or.abs(diag_g(i))>huge(1d0)) bad=bad+1
          enddo
          if(bad/=0) error stop 'implicit: invalid M_E/G diagonal'
       endif
       time_build=wall_time()-t0
       cached_lmin=lmin; cached_lf=lf; cached_ngridmax=ngridmax; imp_valid=.true.
       if(nimhd_check) then
          t0=wall_time()
          call imp_check(bold,info)
          if(info/=0) error stop 'implicit: operator/native-copy checks failed'
          time_check=wall_time()-t0
       endif
    endif
    if(imp_nleaf==0) return
    call imp_gather(bold,y0); call imp_leaf_bc(y0,base_b)
    rejected=.false.; ok=.false.
    ! Retry the whole interval at each depth. Neither native array is changed.
    do split=0,nimhd_maxsplit
       nsub=2**split; y=y0; detotal=0d0
       maxendpoint=0d0; total_esum=0d0; minpressure=huge(1d0)
       do sub=1,nsub
          de0=detotal
          call attempt(y,dt/real(nsub,8),uold,de0,base_b,boxlen,gamma,smallr,etamag,eta_ad,heat, &
               & candidate,de,endpoint,esum,minratio,ok)
          maxendpoint=max(maxendpoint,endpoint); total_esum=total_esum+esum
          minpressure=min(minpressure,minratio)
          if(.not.ok) then
             rejected=.true.
             if(myid==1) write(*,*)'implicit rejection: split,sub,endpoint,energy,min pressure ratio=', &
                  & split,sub,endpoint,esum,minratio
             exit
          endif
          y=candidate
          call axpy(detotal,1d0,de)
       enddo
       if(ok) exit
    enddo
    info=cudaDeviceSynchronize()
    if(info/=0) error stop 'implicit: CUDA execution failed before commit'
    t0=wall_time()
    if(ok) then
       call imp_scatter(y,bold)
       if(heat) call commit_energy<<<(imp_nleaf+255)/256,256>>>(uold,detotal,boxlen,imp_nleaf)
       info=cudaDeviceSynchronize()
       if(info/=0) error stop 'implicit: CUDA execution failed during commit'
    endif
    time_commit=time_commit+wall_time()-t0
    elapsed=wall_time()-tstart
    avg_inner=real(inner_total,8)/real(max(1,inner_calls),8)
    if((verbose.or.first_call.or.rejected).and.myid==1) then
       write(*,*)'implicit: leaves/faces/edges/transition=',imp_nleaf,imp_nface,imp_nedge,imp_ntr, &
            & ' substeps=',nsub,' Picard/COCG=',picard_iters,cocg_iters,' CG max/avg=',inner_max,avg_inner, &
            & ' endpoint=',maxendpoint,' energy sum=',total_esum,' min pressure ratio=',minpressure,' prior p<=0 leaves=',pre_nonpositive,' wall=',elapsed, &
            & ' build/check/coeff/solve/commit=',time_build,time_check,time_coeff,time_solve,time_commit, &
            & ' ME/K applications=',imp_me_calls,imp_k_calls
    endif
    if(.not.ok) error stop 'implicit: exhausted nimhd_maxsplit=2; native state untouched'
    first_call=.false.
  end subroutine gpu_implicit_step
end module implicit_solver
